# Cinema Management System — Environment Variables
# Copy this file to .env and fill in your actual secret values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   docker compose --env-file .env up -d

# ─────────────────────────────────────────────
# DATABASE — Shared PostgreSQL credentials
# ─────────────────────────────────────────────
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────────────────────────────────────────────
# DATABASE — MySQL (Identity Service)
# ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_USER=identity_user
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Leave empty if Redis has no auth (not recommended for production):
# REDIS_PASSWORD=

# ─────────────────────────────────────────────
# KAFKA
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─────────────────────────────────────────────
# JWT (Identity Service + API Gateway)
# ─────────────────────────────────────────────
# Minimum 256-bit (32 bytes) random string — generate with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_VERY_LONG_AND_RANDOM_256BIT_SIGNING_KEY
JWT_VALID_DURATION=3600
JWT_REFRESHABLE_DURATION=36000

# ─────────────────────────────────────────────
# GOOGLE OAUTH2 (Identity Service)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_SECRET
OAUTH_REDIRECT_URI=http://localhost:3000/oauth2/callback

# ─────────────────────────────────────────────
# OTP (Identity Service)
# ─────────────────────────────────────────────
OTP_VALID_DURATION=10

# ─────────────────────────────────────────────
# VNPAY (Payment Service)
# ─────────────────────────────────────────────
VNPAY_TMN_CODE=CHANGE_ME_TMN_CODE
VNPAY_HASH_SECRET=CHANGE_ME_VNPAY_HASH_SECRET
# Sandbox:
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production:
# VNPAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
VNPAY_IPN_URL=http://your-server.com/payment/vnpay-ipn

# ─────────────────────────────────────────────
# BREVO (Notification Service)
# ─────────────────────────────────────────────
BREVO_API_KEY=CHANGE_ME_xkeysib-...
BREVO_SENDER_NAME=Cifastar
BREVO_SENDER_EMAIL=noreply@cifastar.com

# ─────────────────────────────────────────────
# SOCKET.IO (Notification Service)
# ─────────────────────────────────────────────
SOCKETIO_PORT=9100
SOCKETIO_HOST=0.0.0.0

# ─────────────────────────────────────────────
# EUREKA
# ─────────────────────────────────────────────
EUREKA_URI=http://localhost:8761/eureka

# ─────────────────────────────────────────────
# CORS (API Gateway)
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
